async function main() {
  await prisma.masterCOA.deleteMany();
  console.log('Cleared existing COAs.');

  const lines = rawData.split('\n').filter(line => line.trim().length > 0);
  
  for (const line of lines) {
    const parts = line.split('\t').map(p => p.trim());
    if (parts.length < 2) continue;
    
    const accountNumber = parts[0];
    const accountName = parts[1];
    
    await prisma.masterCOA.create({
      data: {
        accountNumber,
        accountName,
      }
    });
    console.log(`Created COA: ${accountNumber} - ${accountName}`);
  }

  console.log('Finished seeding COAs.');
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
